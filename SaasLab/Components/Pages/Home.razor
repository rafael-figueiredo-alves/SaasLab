@page "/"
@layout Layout.PublicLayout
@using SaasLab.Web.Components.Landing
@using SaasLab.Web.Components.Shared
@inherits HomeBase

<SeoHead Titulo="SaasLab: gestão simples para a sua empresa"
         Descricao="Conheça o SaasLab: planos, recursos e relatórios para a sua empresa."
         Caminho="/" />

<section class="hero">
    <h1>Gestão simples para a sua empresa</h1>
    <p>Cadastre sua empresa, convide sua equipe e acompanhe tudo em relatórios.</p>
    <a class="btn" href="/entrar">Acessar o sistema</a>
</section>

<CacheView ExpiresAfter="_expiraCache" Enabled="_cacheHabilitado">
    <SecaoPlanos Planos="_planos" />
</CacheView>